# Headless runtime for Proton + Ubisoft Connect + ACOrigins.
# NVIDIA userspace comes from the host via CDI (--device nvidia.com/gpu=all).
FROM docker.io/library/archlinux:latest

RUN printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf && \
    pacman -Syu --noconfirm --needed \
      python which file procps-ng psmisc util-linux \
      xorg-server-xvfb xorg-xdpyinfo xorg-xwininfo xorg-xprop xdotool imagemagick \
      vulkan-icd-loader lib32-vulkan-icd-loader vulkan-tools \
      libx11 lib32-libx11 libxext lib32-libxext libxrandr lib32-libxrandr \
      libxi lib32-libxi libxcursor lib32-libxcursor libxcomposite lib32-libxcomposite \
      libxfixes lib32-libxfixes libxrender lib32-libxrender libxinerama lib32-libxinerama \
      libxkbcommon lib32-libxkbcommon libxxf86vm lib32-libxxf86vm \
      freetype2 lib32-freetype2 fontconfig lib32-fontconfig ttf-liberation \
      gnutls lib32-gnutls libpulse lib32-libpulse alsa-lib lib32-alsa-lib \
      sdl2 dbus lib32-dbus libgcrypt lib32-libgcrypt \
      gst-plugins-base-libs \
      cabextract unzip && \
    pacman -Scc --noconfirm

# Run as the same uid as the host user so the reflinked prefix is owned correctly.
RUN useradd -u 1000 -m -s /bin/bash steamuser
ENV HOME=/home/steamuser
WORKDIR /home/steamuser

# VNC for the one-time interactive login (Wine text input via Hyprland's Xwayland is unreliable).
USER root
RUN pacman -Sy --noconfirm --needed x11vnc && pacman -Scc --noconfirm

# gamescope headless: GPU-native presentation (Xvfb forces a ~70 ms/frame CPU copy on NVIDIA).
RUN pacman -Sy --noconfirm --needed gamescope xorg-xwayland && pacman -Scc --noconfirm
