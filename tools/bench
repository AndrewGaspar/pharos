#!/usr/bin/env bash
# bench <instance> <label> <pixel_density> [ini overrides key=val ...]
# Restarts the game at the given render scale, enters Discovery Tour, lets it settle, and prints
# the mean of 4 perf reports. Uses the mod in build/mod.
set -euo pipefail
name=$1 label=$2 density=$3; shift 3
here=$(cd "$(dirname "$0")/.." && pwd)
I=/home/ajg/Games/aco-dlss-instances/$name
ini="$I/prefix/drive_c/users/steamuser/Documents/Assassin's Creed Origins/ACO.ini"
sed -i "s/^PixelDensity=.*/PixelDensity=$density/; s/^VSyncMode=.*/VSyncMode=0/" "$ini"
mod=$(mktemp -d); cp -a "$here/build/mod/." "$mod/"
sed -i 's/^render_scale=.*/render_scale=0/' "$mod/pharos.ini"
for kv in "$@"; do sed -i "s/^${kv%%=*}=.*/$kv/" "$mod/pharos.ini"; done
"$here/scripts/aco" game "$name" --mod "$mod" >/dev/null
"$here/scripts/aco-dt" "$name" >/dev/null 2>&1
sleep 12
grep "perf: [0-9]" "$I/out/pharos.log" | tail -4 | sed 's/.*perf: //' |
  awk -v l="$label" '{fps+=$1; split($0,a,"upscale gpu "); split(a[2],b," "); gpu+=b[1]; line=$0} END {printf "%-22s %6.1f fps  upscale gpu %.2f ms  (%s)\n", l, fps/NR, gpu/NR, substr(line, index(line,"render"))}'
rm -rf "$mod"
