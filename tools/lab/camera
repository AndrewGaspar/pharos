#!/usr/bin/env bash
# tools/lab/camera [--instance N] <yaw_deg> [pitch_deg] — turn the game camera to a heading (yaw 0 = +X,
# 90 = +Y; pitch < 0 looks down) with relative mouse-look motion (quiver lab mouse, XTEST) until
# quiver lab where reports it within 0.5 deg. Closed loop, so mouse sensitivity and smoothing don't
# matter. Prints the final camera. (The mod can't do this itself: SendInput from inside the game
# never reaches its raw-input mouse-look under Wine.)
set -euo pipefail
name=${LAB_INSTANCE:-origins}
[[ ${1:-} == --instance ]] && { name=$2; shift 2; }
want_yaw=${1:?yaw}; want_pitch=${2:-}
src=${QUIVER_SOURCE:-agent:pharos-lab}
q() { quiver lab --source "$src" "$@"; }
cam() { q where "$name" | python3 -I -c 'import json,sys; c=json.load(sys.stdin).get("camera") or {}; print(c.get("yaw",""), c.get("pitch",""))'; }
# Gains measured in the lab (deg per pixel of XTEST motion): yaw ~0.117, pitch ~0.077.
gx=0.117; gy=0.077
for i in $(seq 10); do
  read -r yaw pitch <<< "$(cam)"
  [[ -n ${yaw:-} ]] || { echo "camera: no camera readout (game not in the world?)" >&2; exit 1; }
  read -r dx dy done <<< "$(awk -v y="$yaw" -v p="$pitch" -v wy="$want_yaw" -v wp="${want_pitch:-x}" -v gx=$gx -v gy=$gy 'BEGIN {
    e = wy - y; while (e > 180) e -= 360; while (e < -180) e += 360
    ep = (wp == "x") ? 0 : wp - p
    dx = int(-e / gx + (e > 0 ? -0.5 : 0.5)); dy = int(-ep / gy + (ep > 0 ? -0.5 : 0.5))
    print dx, dy, (e < 0.5 && e > -0.5 && ep < 0.5 && ep > -0.5) }')"
  ((done)) && break
  # Large turns in steps: the game clamps very large single mouse deltas.
  steps=$(awk -v x="$dx" -v y="$dy" 'BEGIN { x = x < 0 ? -x : x; y = y < 0 ? -y : y; n = int(x / 400 + 1); m = int(y / 300 + 1); print (n > m ? n : m) }')
  q mouse "$name" "$dx" "$dy" --steps "$steps" >/dev/null
  # Camera smoothing: wait until the picture stops turning.
  q wait "$name" frame --stable 3 --timeout 5 >/dev/null 2>&1 || true
done
read -r yaw pitch <<< "$(cam)"
echo "camera: yaw $yaw pitch $pitch"
