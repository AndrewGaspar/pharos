#!/usr/bin/env bash
# fg-shots <instance> <outdir> [kinds...]
# Frame Generation debugging: switches [fg] show= live to each kind (default: real generated) and
# takes a screenshot of each, then prints mean colour and the RMSE of each kind against "real".
set -euo pipefail
name=$1 out=$2; shift 2
kinds=("$@")
[[ $# -eq 0 ]] && kinds=(real generated)
here=$(cd "$(dirname "$0")/.." && pwd)
ini="/home/ajg/Games/aco-dlss-instances/$name/prefix/drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/games/Assassin's Creed Origins/aco_dlss.ini"
mkdir -p "$out"
for k in "${kinds[@]}"; do
  sed -i "/^\[fg\]/,\$ s/^show=.*/show=$k/" "$ini"
  sleep 3
  "$here/scripts/aco" shot "$name" "$out/$k.png" >/dev/null
done
sed -i '/^\[fg\]/,$ s/^show=.*/show=both/' "$ini"
for k in "${kinds[@]}"; do
  m=$(magick "$out/$k.png" -format "%[fx:mean.r] %[fx:mean.g] %[fx:mean.b] %wx%h" info:)
  d=""
  [[ $k != real && -f $out/real.png ]] && d=$( (magick compare -metric RMSE "$out/real.png" "$out/$k.png" null: 2>&1 || true) | sed -n 's/.*(\(.*\)).*/rmse vs real \1/p')
  echo "$k: mean $m $d"
done
files=(); for k in "${kinds[@]}"; do files+=("$out/$k.png"); done
magick "${files[@]}" +append "$out/side-by-side.png" 2>/dev/null || true
