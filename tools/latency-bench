#!/usr/bin/env bash
# latency-bench <instance> <label> [section.key=value ...]
# Fresh game launch with the given aco_dlss.ini overrides (e.g. reflex.mode=off upscaler.enabled=0),
# enters Discovery Tour, settles, then runs tools/latency (40 mouse-look injections). Fresh launches
# avoid carry-over between configurations (e.g. Reflex state inside DXVK). Results are copied to
# build/latency/<label>/.
set -euo pipefail
name=$1 label=$2; shift 2
here=$(cd "$(dirname "$0")/.." && pwd)
mod=$(mktemp -d); cp -a "$here/build/mod/." "$mod/"
for kv in "$@"; do
  sec=${kv%%.*}; rest=${kv#*.}; key=${rest%%=*}; val=${rest#*=}
  python3 -I - "$mod/aco_dlss.ini" "$sec" "$key" "$val" <<'PY'
import sys
p, sec, key, val = sys.argv[1:]
lines = open(p).read().split("\n"); cur = None; done = False
for i, l in enumerate(lines):
    s = l.strip()
    if s.startswith("["): cur = s[1:-1]
    elif cur == sec and s.split("=")[0] == key: lines[i] = f"{key}={val}"; done = True
if not done: sys.exit(f"no {sec}.{key} in {p}")
open(p, "w").write("\n".join(lines))
PY
done
"$here/scripts/aco" kill-game "$name" >/dev/null
"$here/scripts/aco" game "$name" --mod "$mod" >/dev/null
"$here/scripts/aco-dt" "$name" >/dev/null 2>&1 || { echo "$label: failed to enter Discovery Tour"; exit 1; }
sleep 15
I=/home/ajg/Games/aco-dlss-instances/$name
echo "##### $label ($*)"
"$here/tools/latency" "$name" 40 150 1 | grep -E "fps|reactions|WARN|stage|recorded|called|ran|done"
mkdir -p "$here/build/latency/$label"; cp "$I"/out/latency_*.csv "$I/out/inject.csv" "$here/build/latency/$label/"
rm -rf "$mod"
