#!/usr/bin/env bash
# latency <instance> [count=40] [dx=150] [threshold_deg=0.05]
# Measures input-to-frame latency in a running instance (game in Discovery Tour, mouse-look
# possible): turns on the mod's latency logging, injects <count> mouse-look motions of <dx>
# pixels through XTEST at random 0.4-0.7 s intervals, then analyses (tools/latency.py).
set -euo pipefail
name=$1 count=${2:-40} dx=${3:-150} thr=${4:-0.05}
here=$(cd "$(dirname "$0")/.." && pwd)
I=/home/ajg/Games/aco-dlss-instances/$name
ini="$I/prefix/drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/games/Assassin's Creed Origins/aco_dlss.ini"
grep -q '^latency_log=' "$ini" || printf 'latency_log=0\n' >> "$ini"
rm -f "$I/out/latency_taa.csv" "$I/out/latency_present.csv" "$I/out/inject.csv"
sed -i 's/^latency_log=.*/latency_log=1/' "$ini"
sleep 3
cp "$here/tools/inject_mouse.py" "$I/out/"
"$here/scripts/aco" exec "$name" python3 /out/inject_mouse.py /out/inject.csv "$count" "$dx"
sleep 1
sed -i 's/^latency_log=.*/latency_log=0/' "$ini"
sleep 3
grep "latency:" "$I/out/aco_dlss.log" | tail -3 | sed 's/^/  /'
python3 "$here/tools/latency.py" "$I/out" "$thr"
