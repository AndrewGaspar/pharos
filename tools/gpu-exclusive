#!/usr/bin/env bash
# gpu-exclusive <instance> <command...>
# Runs a measurement with the GPU (nearly) to itself: takes a lock (so measurements from parallel
# workstreams queue up instead of overlapping), throttles every other running instance's game to
# 5 fps through its live aco_dlss.ini (Reflex fps_limit), runs the command, and restores the other
# instances' settings afterwards (also on failure/interrupt). Freezing containers (podman pause)
# was tried first and leaves the paused games hung after resuming.
set -euo pipefail
name=$1; shift
root=/home/ajg/Games/aco-dlss-instances
rel="prefix/drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/games/Assassin's Creed Origins/aco_dlss.ini"
exec 9>"$root/.gpu-exclusive.lock"
flock 9
saved=()
restore() {
  for n in "${saved[@]}"; do
    [[ -f "$root/$n/.gpu-exclusive.ini" ]] && cp "$root/$n/.gpu-exclusive.ini" "$root/$n/$rel" && rm -f "$root/$n/.gpu-exclusive.ini"
  done
}
trap restore EXIT INT TERM
for c in $(podman ps --format '{{.Names}}' --filter status=running | grep '^aco-'); do
  n=${c#aco-}; [[ $n == "$name" ]] && continue
  ini="$root/$n/$rel"; [[ -f $ini ]] || continue
  cp "$ini" "$root/$n/.gpu-exclusive.ini"; saved+=("$n")
  sed -i "/^\[reflex\]/,\$ { s/^fps_limit=.*/fps_limit=5/; s/^mode=.*/mode=on/ }" "$ini"
done
if ((${#saved[@]})); then echo "gpu-exclusive: throttled ${saved[*]} to 5 fps" >&2; sleep 4; fi
"$@" 9>&-   # children must not inherit the lock fd (detached podman exec sessions would hold it forever)
