#!/usr/bin/env bash
# fg-series <instance> <prefix> "label|section.key=value ..." ...
# Live A/B of Frame Generation settings in one running session: for each spec, edits the live
# aco_dlss.ini (tools/ini-set), lets it settle, runs tools/fg-trace (constant-rate camera spin +
# present trace) and prints the cadence/smoothness summary plus the FG / Reflex perf lines.
# Results: build/fgtrace/<prefix>-<label>/. Every wait has a deadline.
set -uo pipefail
name=$1 prefix=$2; shift 2
here=$(cd "$(dirname "$0")/.." && pwd)
L=/home/ajg/Games/aco-dlss-instances/$name/out/aco_dlss.log
for spec in "$@"; do
  label=${spec%%|*}; kvs=${spec#*|}
  # shellcheck disable=SC2086
  [[ -n $kvs && $kvs != "$spec" ]] && "$here/tools/ini-set" "$name" $kvs
  sleep 8
  n=$(wc -l < "$L")
  timeout 240 "$here/tools/fg-trace" "$name" "$prefix-$label" > /dev/null 2>&1 || echo "$label: trace failed"
  d=$here/build/fgtrace/$prefix-$label
  echo "##### $label ($kvs)"
  [[ -f $d/report.txt ]] && grep -E "span|arrival interval|interval G->R|interval R->G|interval N->N|after game|shift ratio|outside|residual vs|display vrr" "$d/report.txt" | cut -c1-170
  tail -n +"$n" "$L" | grep -E "perf: fg real|game waited|reflex sleep|reflex:|completion check" | cut -c14-220 |
    sed -E 's/after the game.s Present: generated presented/G +/; s/, real / R /' | tail -n 5 | sed 's/^/    /'
done
