#!/usr/bin/env bash
# DEPRECATED (2026-11-20): the podman harness (aco-t* containers) is retired; use tools/lab/dt. See docs/ENGINE_NOTES.md, Tools.
# aco-dt <instance> [--story] [location] — drive a freshly launched game (aco game ...) into
# Discovery Tour free roam; with a location (tools/teleport <inst> list), teleport there afterwards.
# --story: continue the story instead (main menu > Play > first profile, which loads its latest
# save; e.g. a fixture installed with `scripts/aco fixture`).
#
# Screen states are recognised by comparing fixed regions of the (2560x1600-scaled) display against
# reference crops in tools/ref/. Input is only sent when a state is positively recognised, so we
# never press Return on an unknown screen (which could e.g. load a story save).
set -euo pipefail
name=${1:?instance}; shift
story=0; [[ ${1:-} == --story ]] && { story=1; shift; }
location=${1:-}
here=$(cd "$(dirname "$0")/.." && pwd)
ref=$here/tools/ref
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
aco=$here/scripts/aco

# state name | crop geometry | reference file
STATES=(
  "title|400x60+1080+1412|title.png"
  "menu|600x110+205+537|menu.png"
)

# Reference crops and click positions are for a 2560x1600 display; other 16:10 sizes are scaled.
res=$(cat "/home/ajg/Games/aco-dlss-instances/$name/res" 2>/dev/null || echo 2560x1600)
W=${res%x*}
grab() {
  "$aco" shot "$name" "$tmp/shot.png" >/dev/null
  magick "$tmp/shot.png" -resize '2560x1600!' "$tmp/full.png"
}

# Prints the matching state name, or "unknown".
classify() {
  local s st geo file d
  for s in "${STATES[@]}"; do
    IFS='|' read -r st geo file <<< "$s"
    [[ -f $ref/$file ]] || continue
    magick "$tmp/full.png" -crop "$geo" +repage -colorspace gray "$tmp/c.png"
    local r=$ref/$file
    if ((W < 2560)); then  # degrade the reference like the upscaled low-res capture
      magick "$r" -resize "$((W * 100 / 2560))%" -resize "${geo%%+*}!" -colorspace gray "$tmp/r.png"; r=$tmp/r.png
    fi
    d=$(magick compare -metric RMSE "$r" "$tmp/c.png" null: 2>&1 | sed -n 's/.*(\(.*\)).*/\1/p')
    if awk "BEGIN{exit !(${d:-1} < 0.08)}"; then echo "$st"; return; fi
  done
  echo unknown
}

press() { "$aco" keys "$name" keydown "$1" sleep 0.15 keyup "$1"; }
click() {
  local x=$(( $1 * W / 2560 )) y=$(( $2 * W / 2560 ))
  "$aco" keys "$name" mousemove "$x" "$y" sleep 0.3 mousedown 1 sleep 0.12 mouseup 1
}

deadline=$((SECONDS + 300))
while ((SECONDS < deadline)); do
  grab
  st=$(classify)
  case $st in
    title) echo "aco-dt: title -> pressing Return"; press Return; sleep 8;;
    menu)  if ((story)); then
             echo "aco-dt: main menu -> Play -> first profile (continue story)"
             click 507 263; sleep 3; click 533 400; sleep 3
           else
             echo "aco-dt: main menu -> Discovery Tour"; click 380 592; sleep 3
           fi
           # Wait for the player to be in the world (the mod answers tools/where; while loading the
           # player stands in the Animus void near (-100, 33.5, 0.2)), then let streaming settle.
           # Without the mod's teleport support this falls back to a fixed wait.
           t_load=$SECONDS; in_world=0
           while ((SECONDS < t_load + 120)); do
             if pos=$("$here/tools/where" "$name" 2>/dev/null) &&
                awk '{exit !($1 != "none" && ($3 > 5 || $3 < -5))}' <<< "$pos"; then in_world=1; break; fi
             sleep 2
           done
           if ((in_world)); then sleep 12; else sleep $((45 - (SECONDS - t_load) > 0 ? 45 - (SECONDS - t_load) : 0)); fi
           echo "aco-dt: in $( ((story)) && echo story mode || echo Discovery Tour) ($((SECONDS - t_load)) s after selecting it)"
           if [[ -n $location ]]; then "$here/tools/teleport" "$name" "$location" --settle 5 || exit 1; fi
           exit 0;;
    *)     sleep 3;;
  esac
done
echo "aco-dt: timed out (last frame: $tmp/full.png)" >&2
cp "$tmp/full.png" "$here/build/aco-dt-timeout.png" 2>/dev/null || true
exit 1
